# Managed by setup repo — Oh My Zsh + powerlevel10k (Linux/VPS: без Windows-hotkeys)

typeset -g POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
if [[ ! -f ~/.p10k.zsh ]]; then
  typeset -g POWERLEVEL9K_INSTANT_PROMPT=off
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  history
  zsh-autosuggestions
  zsh-history-substring-search
  zsh-syntax-highlighting
)

if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

typeset -g ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=252'
typeset -g ZSH_HIGHLIGHT_STYLES[command-not-found]='fg=red,bold'

if command -v thefuck &>/dev/null; then
  eval "$(thefuck --alias)"
fi

if command -v fzf &>/dev/null; then
  eval "$(fzf --zsh 2>/dev/null)" || true
fi

_ws_eza() {
  if command -v eza &>/dev/null; then
    command eza "$@"
  else
    command ls "$@"
  fi
}
alias ls='_ws_eza --tree --level=1 --group-directories-first --color=always'

bindkey -e
setopt transient_rprompt 2>/dev/null

if [[ -o interactive && -t 0 ]]; then
  setopt monitor 2>/dev/null
  bindkey '^H' history-incremental-search-backward
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
fi

[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

if (( $+functions[autosuggest-accept] )); then
  bindkey '^[[1;5C' autosuggest-accept
  bindkey '^E' end-of-line
fi
